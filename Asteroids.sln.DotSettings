    <s:String x:Key="/Default/CodeStyle/CSharpFileLayoutPatterns/Pattern/@EntryValue">&lt;Patterns xmlns="urn:schemas-jetbrains-com:member-reordering-patterns"
          xmlns:unity="urn:schemas-jetbrains-com:member-reordering-patterns-unity"&gt;

  &lt;TypePattern DisplayName="Non-reorderable types"&gt;
    &lt;TypePattern.Match&gt;
      &lt;Or&gt;
        &lt;HasAttribute Name="JetBrains.Annotations.NoReorderAttribute" /&gt;
        &lt;HasAttribute Name="JetBrains.Annotations.NoReorder" /&gt;
      &lt;/Or&gt;
    &lt;/TypePattern.Match&gt;
  &lt;/TypePattern&gt;
  
  &lt;TypePattern DisplayName="ECS Systems"&gt;
    &lt;TypePattern.Match&gt;
        &lt;Name Is=".*System" /&gt;
    &lt;/TypePattern.Match&gt;
    
     &lt;Entry DisplayName="Constant Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Constant" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Static Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Field" /&gt;
          &lt;Static /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="IFaces" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Interface" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Field" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
        &lt;Readonly /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
      
    &lt;Entry DisplayName="Static Properties, Indexers"&gt;
          &lt;Entry.Match&gt;
              &lt;And&gt;
                  &lt;Or&gt;
                      &lt;Kind Is="Property" /&gt;
                      &lt;Kind Is="Indexer" /&gt;
                  &lt;/Or&gt;
                  &lt;Static /&gt;
              &lt;/And&gt;
          &lt;/Entry.Match&gt;

          &lt;Entry.SortBy&gt;
              &lt;Access /&gt;
          &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Properties, Indexers"&gt;
          &lt;Entry.Match&gt;
              &lt;Or&gt;
                  &lt;Kind Is="Property" /&gt;
                  &lt;Kind Is="Indexer" /&gt;
              &lt;/Or&gt;
          &lt;/Entry.Match&gt;

          &lt;Entry.SortBy&gt;
              &lt;Access /&gt;
          &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Constructors"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Constructor" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Static /&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Lifetime"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Or&gt;
            &lt;Name Is="OnInitialize" /&gt;
            &lt;Name Is="OnUpdate" /&gt;
          &lt;/Or&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="All other members" /&gt;
    
    &lt;Entry DisplayName="Destructors" Priority="200"&gt;
      &lt;Entry.Match&gt;
        &lt;Name Is="Dispose" /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Enums" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Enum" /&gt;
      &lt;/Entry.Match&gt;
      
      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Nested Types"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Type" /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
  &lt;/TypePattern&gt;
  
  &lt;TypePattern DisplayName="Common types"&gt;
    
    &lt;Entry DisplayName="Constant Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Constant" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Static Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Field" /&gt;
          &lt;Static /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="IFaces" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Interface" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Delegates" Priority="200"&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is="Delegate" /&gt;
          &lt;Kind Is="Event" /&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Inject Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Field" /&gt;
          &lt;HasAttribute Name="Inject" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Readonly /&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Serialized Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;unity:SerializedField /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Fields"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Field" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
        &lt;Readonly /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Static Properties, Indexers"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Or&gt;
            &lt;Kind Is="Property" /&gt;
            &lt;Kind Is="Indexer" /&gt;
          &lt;/Or&gt;
          &lt;Static /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Properties, Indexers"&gt;
      &lt;Entry.Match&gt;
        &lt;Or&gt;
          &lt;Kind Is="Property" /&gt;
          &lt;Kind Is="Indexer" /&gt;
        &lt;/Or&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Constructors"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Constructor" /&gt;
      &lt;/Entry.Match&gt;

      &lt;Entry.SortBy&gt;
        &lt;Static /&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;
   
    &lt;Entry DisplayName="Initialize On Load Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Or&gt;
            &lt;HasAttribute Name="RuntimeInitializeOnLoad" /&gt;
            &lt;HasAttribute Name="InitializeOnLoad" /&gt;
            &lt;HasAttribute Name="InitializeOnLoadMethod" /&gt;
            &lt;HasAttribute Name="InitializeOnEnterPlayMode" /&gt;
          &lt;/Or&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="OnConstruct Method"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Name Is="OnConstruct" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
   
    &lt;Entry DisplayName="Inject Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;HasAttribute Name="Inject" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="OnAfterInject Method"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Name Is="OnAfterInject" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="OnModelSet Method"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Name Is="OnModelSet" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Nodes and UI Lifetime"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Kind Is="Method" /&gt;
          &lt;Or&gt;
            &lt;Name Is="OnActivate" /&gt;
            &lt;Name Is="OnAfterActivate" /&gt;
            &lt;Name Is="OnDeactivate" /&gt;
            &lt;Name Is="OnAfterDeactivate" /&gt;
            &lt;Name Is="OnAfterInitialize" /&gt; &lt;!-- Storage --&gt;
          &lt;/Or&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Public Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Access Is="Public" /&gt;
          &lt;Kind Is="Method" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Protected Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Access Is="Protected" /&gt;
          &lt;Kind Is="Method" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Private Methods"&gt;
      &lt;Entry.Match&gt;
        &lt;And&gt;
          &lt;Access Is="Private" /&gt;
          &lt;Kind Is="Method" /&gt;
        &lt;/And&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Destructors" Priority="200"&gt;
      &lt;Entry.Match&gt;
        &lt;Name Is="Dispose" /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
    &lt;Entry DisplayName="Enums" Priority="100"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Enum" /&gt;
      &lt;/Entry.Match&gt;
      
      &lt;Entry.SortBy&gt;
        &lt;Access /&gt;
      &lt;/Entry.SortBy&gt;
    &lt;/Entry&gt;

    &lt;Entry DisplayName="Nested Types"&gt;
      &lt;Entry.Match&gt;
        &lt;Kind Is="Type" /&gt;
      &lt;/Entry.Match&gt;
    &lt;/Entry&gt;
    
  &lt;/TypePattern&gt;
  
&lt;/Patterns&gt;</s:String>
