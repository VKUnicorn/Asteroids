/[Ll]ibrary/
/[Uu]ser[Ss]ettings/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Pp]ackages/.*
/AssetBundles/
/Logs/
.vscode/
.idea/
.vs/

# MemoryCaptures can get excessive in size.
# They also could contain extremely sensitive data
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated VS/MD solution and project files
/*.csproj
/*.csproj.meta
/*.unityproj
/*.sln
.suo
/*.user
/*.userprefs
/*.pidb
/*.booproj

# Unity3D Generated File On Crash Reports
sysinfo.txt
/Assets/Plugins/Editor/JetBrains*

# Crashlytics generated file
crashlytics-build.properties

# Ignore the Cache folder since it is updated locally.
/[Aa]ssets/Plugins/FMOD/Cache/*

# Ignore bank files in the StreamingAssets folder.
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta

# Log files can be ignored.
fmod_editor.log

# Symbolic Links
/[Aa]ssets/[Ss]ym[Ll]inks.meta
/[Aa]ssets/[Ss]ym[Ll]inks/*

# Locals
/**/_LOCAL_/
/**/_LOCAL_.meta

# Agents
.claude/settings.local.json
.augment*
.cursor*

# Temporary auto-generated Android Assets
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# Project Custom
.gradle
/Assets/FR2_Cache.asset
/Assets/FR2_Cache.asset.meta
/Assets/Editor/RemoteConfig*
/Assets/Editor/RemoteConfig.meta
/Assets/Local.meta
/Assets/Rowlan.meta
/Assets/StreamingAssets.meta
/Assets/BuildReport/
/Assets/BuildReport.meta
/ServerData/
/com.Tivadar.*
/.utmp/
obfuscation.txt
/fbg.log
/nul
*.exe.stackdump
.deepseek/
/ProfilerCaptures
Docs/GameStats/export/

# Superpowers SDD scratch (git-ignored workspace)
/.superpowers/
